---
import { site } from '../data/site';
---

<header class="site-header">
  <div class="wrap wrap-wide bar">
    <a href="#top" class="mark">{site.name}</a>
    <nav>
      <a href="#work">work</a>
      <a href="#about">about</a>
      <a href="#contact">contact</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.85rem;
  }
  .mark {
    font-family: var(--font-display);
    font-size: 1.2rem;
    letter-spacing: -0.01em;
  }
  nav {
    display: flex;
    gap: clamp(1rem, 3vw, 1.75rem);
    font-size: 0.92rem;
    color: var(--muted);
  }
  nav a {
    color: var(--muted);
  }
  nav a:hover {
    color: var(--ink);
  }
  @media (max-width: 30rem) {
    nav a:nth-child(3) {
      display: none;
    }
  }
</style>
