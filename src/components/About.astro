---
import { aboutFacts } from '../data/site';
---

<section class="section" id="about">
  <div class="wrap about-grid">
    <div class="photo">
      <img src="/img/prof.jpg" alt="Ben Kaye" width="640" height="640" loading="lazy" />
    </div>
    <div>
      <p class="label">about</p>
      <dl class="facts">
        {
          aboutFacts.map((f) => (
            <div class="fact">
              <dt>{f.when}</dt>
              <dd>{f.what}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: clamp(1.5rem, 5vw, 3rem);
    align-items: start;
  }
  .photo img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border: 1px solid var(--border);
  }
  .facts {
    margin: 0;
  }
  .fact {
    padding-block: 1rem;
    border-top: 1px solid var(--border);
  }
  .fact:first-child {
    border-top: none;
    padding-top: 0;
  }
  dt {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
    margin-bottom: 0.3rem;
  }
  dd {
    margin: 0;
    color: var(--ink);
  }
  @media (max-width: 34rem) {
    .about-grid {
      grid-template-columns: 1fr;
    }
    .photo {
      max-width: 9rem;
    }
  }
</style>
