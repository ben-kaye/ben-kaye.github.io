---
import { site, links } from '../data/site';
---

<section class="section hero" id="top">
  <div class="wrap">
    <div class="masthead">
      <div class="photo">
        <img
          src="/img/headshot.webp"
          alt={site.name}
          width="700"
          height="934"
          fetchpriority="high"
        />
      </div>
      <div class="intro">
        <h1>{site.name}</h1>
        <p class="role">{site.role}</p>
        <ul class="links">
          {
            links.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div class="bio">
      {site.bio.map((para) => <p>{para}</p>)}
    </div>
    <div class="affiliations" aria-label="Affiliations">
      <span class="affil" aria-label="University of Oxford">
        <img src="/img/logos/oxford.svg" alt="" class="oxford-mark" />
      </span>
      <span class="divider" aria-hidden="true"></span>
      <span class="affil" aria-label="OrganOx">
        <img src="/img/logos/organox-square.svg" alt="" class="organox-mark" />
        <span class="organox-word">OrganOx</span>
      </span>
      <span class="divider" aria-hidden="true"></span>
      <span class="affil" aria-label="Y Combinator">
        <img src="/img/logos/yc.svg" alt="" width="28" height="28" class="yc-mark" />
        <span class="yc-word">Combinator</span>
      </span>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(3rem, 9vw, 5.5rem);
    padding-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }
  .masthead {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 5vw, 3rem);
  }
  .photo {
    flex-shrink: 0;
    width: clamp(7.5rem, 22vw, 10.5rem);
    aspect-ratio: 3 / 4;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  h1 {
    font-size: clamp(2.4rem, 8vw, 3.8rem);
    margin-bottom: 0.4rem;
  }
  .role {
    color: var(--muted);
    margin: 0 0 1.1rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.95rem;
  }
  .links a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--border);
  }
  .links a:hover {
    text-decoration-color: var(--accent);
    color: var(--accent);
  }
  .bio {
    max-width: 38rem;
    margin-top: clamp(2rem, 6vw, 3rem);
  }
  .bio :global(p) {
    margin-bottom: 1rem;
  }
  .affiliations {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: clamp(1rem, 4vw, 2rem);
    margin-top: clamp(1.75rem, 5vw, 2.5rem);
    color: var(--muted);
  }
  .affil {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: inherit;
  }
  .affil svg {
    height: 2rem;
    width: auto;
    fill: currentColor;
  }
  .divider {
    width: 1px;
    height: 1.6rem;
    background: var(--border);
  }
  .oxford-mark {
    height: 2rem;
    width: auto;
    display: block;
  }
  .organox-mark {
    height: 1.75rem;
    width: 1.75rem;
    display: block;
  }
  .organox-word {
    font-size: 1.1rem;
    letter-spacing: 0.01em;
  }
  .yc-mark {
    height: 1.75rem;
    width: 1.75rem;
    display: block;
  }
  .yc-word {
    font-size: 1.1rem;
    letter-spacing: 0.01em;
  }
  @media (max-width: 34rem) {
    .masthead {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }
    .photo {
      width: 8rem;
    }
    /* Wrapping a divider-separated row leaves dividers dangling at line
       ends. Drop the dividers and let the marks wrap cleanly. */
    .affiliations {
      gap: 1.25rem 1.5rem;
    }
    .divider {
      display: none;
    }
    /* Comfortable tap targets without shifting the visual baseline: pad the
       links and pull the row back with a matching negative margin. */
    .links {
      row-gap: 0;
      margin-block: -0.6rem;
    }
    .links a {
      display: inline-block;
      padding-block: 0.6rem;
    }
  }
</style>
