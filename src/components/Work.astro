---
import { work } from '../data/site';
---

<section class="section" id="work">
  <div class="wrap">
    <p class="label">selected work</p>
    <ol class="list">
      {
        work.map((item) => (
          <li class="item">
            <div class="head">
              <h3>{item.title}</h3>
              <span class="year">{item.year}</span>
            </div>
            {item.tag && (
              <p class:list={['tag', { published: item.published }]}>{item.tag}</p>
            )}
            {item.authors && (
              <p class="authors">
                {item.authors.map((a, i) => (
                  <span class:list={['author', { me: a.me }]}>{i > 0 ? ', ' : ''}{a.name}{a.eq && <sup>*</sup>}</span>
                ))}
                {item.authors.some((a) => a.eq) && (
                  <span class="eqnote"><sup>*</sup> equal contribution</span>
                )}
              </p>
            )}
            <p class="blurb">{item.blurb}</p>
            <a class="link" href={item.href}>{item.cta}</a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .item {
    padding-block: 1.6rem;
    border-top: 1px solid var(--border);
  }
  .item:first-child {
    border-top: none;
    padding-top: 0;
  }
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  h3 {
    font-size: 1.35rem;
  }
  .year {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    flex-shrink: 0;
  }
  .tag {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0.35rem 0 0;
  }
  .tag.published {
    color: var(--accent);
  }
  .authors {
    font-size: 0.92rem;
    color: var(--muted);
    margin: 0.5rem 0 0;
  }
  .author.me {
    color: var(--ink);
    font-weight: 500;
  }
  .authors sup {
    font-size: 0.7em;
    line-height: 0;
  }
  .eqnote {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .blurb {
    color: var(--muted);
    margin: 0.6rem 0 0.7rem;
  }
  .link {
    font-size: 0.95rem;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }
</style>
