---
import { work } from '../data/site';
---

<section class="section" id="work">
  <div class="wrap">
    <p class="label">publications</p>
    <ol class="list">
      {
        work.map((item) => (
          <li class:list={['item', { 'has-media': item.image }]}>
            {item.image && (
              <div class="media">
                <img src={item.image} alt={item.title} loading="lazy" />
              </div>
            )}
            <div class="body">
              <h3>{item.title}</h3>
              {item.authors && (
                <p class="authors">
                  {item.authors.map((a, i) => (
                    <span class:list={['author', { me: a.me }]}>{i > 0 ? ', ' : ''}{a.name}{a.eq && <sup>*</sup>}</span>
                  ))}
                  {item.authors.some((a) => a.eq) && (
                    <span class="eqnote"><sup>*</sup> equal contribution</span>
                  )}
                </p>
              )}
              {item.tag && (
                <p class:list={['tag', { published: item.published }]}>{item.tag}</p>
              )}
              <p class="blurb">{item.blurb}</p>
              <p class="links">
                {item.links.map((l, i) => (
                  <>
                    {i > 0 && <span class="sep">·</span>}
                    <a href={l.href}>{l.label}</a>
                  </>
                ))}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .section {
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .item {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    padding-block: 1.8rem;
    border-top: 1px solid var(--border);
  }
  .item.has-media {
    grid-template-columns: 10rem 1fr;
  }
  .item:first-child {
    border-top: none;
    padding-top: 0;
  }
  .media {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
  }
  .media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  h3 {
    font-size: 1.3rem;
  }
  .authors {
    font-size: 0.92rem;
    color: var(--muted);
    margin: 0.4rem 0 0;
  }
  .author.me {
    color: var(--ink);
    font-weight: 500;
  }
  .authors sup {
    font-size: 0.7em;
    line-height: 0;
  }
  .eqnote {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .tag {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0.35rem 0 0;
  }
  .tag.published {
    color: var(--accent);
  }
  .blurb {
    color: var(--muted);
    margin: 0.6rem 0 0.7rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
    font-size: 0.95rem;
  }
  .links a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }
  .links .sep {
    color: var(--border);
  }
  @media (max-width: 34rem) {
    .item.has-media {
      grid-template-columns: 1fr;
    }
    .media {
      max-width: 10rem;
    }
  }
</style>
