---
import { site } from '../data/site';
const year = 2026;
---

<footer class="site-footer">
  <div class="wrap wrap-wide row">
    <span>© {year} {site.name}</span>
    <span>{site.location}</span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding-block: 2rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
