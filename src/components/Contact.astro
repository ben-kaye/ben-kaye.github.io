---
import { links } from '../data/site';
---

<section class="section" id="contact">
  <div class="wrap">
    <p class="label">contact</p>
    <p class="line">
      Email is the best way to reach me. I read everything, and reply to most of it.
    </p>
    <ul class="links">
      {
        links.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .line {
    color: var(--ink);
    max-width: 34rem;
    margin-top: 0;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    font-size: 0.95rem;
  }
  .links a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }
  .links a:hover {
    color: var(--accent);
  }
</style>
