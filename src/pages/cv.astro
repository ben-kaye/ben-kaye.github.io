---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import { site, aboutFacts } from '../data/site';
---

<Base
  title={`CV - ${site.name}`}
  description={`Curriculum vitae for ${site.name}: ${site.role}, Y Combinator-backed robotics founder, and former OrganOx engineer.`}
>
  <main>
    <section class="section">
      <div class="wrap">
        <p class="back"><a href="/">&larr; {site.name}</a></p>
        <table class="cv">
          <tbody>
            {
              aboutFacts.map((f) => (
                <tr>
                  <th scope="row">{f.when}</th>
                  <td class="role">{f.role}</td>
                  <td class="detail">{f.detail}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .back {
    margin-bottom: clamp(2rem, 6vw, 3rem);
    font-size: 0.95rem;
  }
  .back a {
    color: var(--muted);
    text-decoration: none;
  }
  .back a:hover {
    color: var(--accent);
  }
  .cv {
    width: 100%;
    max-width: 48rem;
    border-collapse: collapse;
  }
  .cv tr {
    border-top: 1px solid var(--border);
  }
  .cv tr:first-child {
    border-top: none;
  }
  .cv th,
  .cv td {
    text-align: left;
    vertical-align: top;
    padding: 1rem 0;
    font-weight: normal;
  }
  .cv th {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
    white-space: nowrap;
    padding-right: 1.5rem;
    width: 1%;
  }
  .cv .role {
    color: var(--ink);
    padding-right: 1.5rem;
  }
  .cv .detail {
    color: var(--muted);
  }
  @media (max-width: 34rem) {
    .back {
      margin-top: -0.5rem;
    }
    .back a {
      display: inline-block;
      padding-block: 0.6rem;
      font-size: 1.15rem;
      color: var(--ink);
    }
  }
  @media (max-width: 40rem) {
    .cv,
    .cv tbody,
    .cv tr,
    .cv th,
    .cv td {
      display: block;
      width: auto;
    }
    .cv th {
      padding: 1rem 0 0.3rem;
    }
    .cv .role {
      padding: 0;
    }
    .cv .detail {
      padding: 0.2rem 0 1rem;
    }
  }
</style>
